{
  "name": "@royalpinto007/paylint",
  "version": "0.1.1",
  "type": "module",
  "license": "MIT",
  "description": "Inspect Solana Pay links and QR codes locally without connecting a wallet or making payments.",
  "author": "Royal Pinto <royalpinto007@gmail.com>",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "demo": "npm run build && node dist/cli.js",
    "start": "node dist/cli.js",
    "build": "tsc -p tsconfig.build.json && node scripts/build.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "prepack": "npm run build",
    "package:check": "npm run build && node scripts/check-package.mjs"
  },
  "dependencies": {
    "bs58": "^6.0.0",
    "jsqr": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "bin": {
    "paylint": "dist/cli.js"
  },
  "files": [
    "dist/",
    "docs/*.md",
    "docs/*.svg",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/royalpinto007/paylint.git"
  },
  "homepage": "https://www.npmjs.com/package/@royalpinto007/paylint",
  "bugs": {
    "url": "https://github.com/royalpinto007/paylint/issues"
  },
  "keywords": [
    "solana",
    "solana-pay",
    "qr-code",
    "inspector",
    "offline",
    "cli"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
